{
  "expo": {
    "name": "Machination",
    "slug": "machination",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mcclowes.machination"
    },
    "android": {
      "package": "com.mcclowes.machination"
    },
    "web": {
      "bundler": "metro",
      "name": "Machination",
      "description": "Slow orbits. Cold decisions."
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/withMinimumIosTarget.cjs",
      "./plugins/withIosScenes.cjs"
    ]
  }
}
