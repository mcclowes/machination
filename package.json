{
  "name": "machination",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "npm test && npm run typecheck && npm run test:server-build",
    "build:web": "expo export --platform web",
    "build:brand": "node scripts/build-brand.mjs",
    "build:sounds": "node scripts/build-sounds.mjs",
    "server": "tsx server/main.ts",
    "build:android:playtest": "expo prebuild --platform android --no-install && cd android && ./gradlew :app:assembleRelease -PreactNativeArchitectures=arm64-v8a --console=plain --max-workers=2",
    "build:ios:simulator": "expo prebuild --platform ios --no-install && cd ios && pod install && cd .. && xcodebuild -workspace ios/Machination.xcworkspace -scheme Machination -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build/playtest CODE_SIGNING_ALLOWED=YES CODE_SIGN_IDENTITY=- CODE_SIGNING_REQUIRED=YES -jobs 2 build",
    "build:server": "node scripts/build-server.mjs",
    "test:server-build": "npm run build:server && node --test scripts/build-server.test.mjs",
    "server:production": "node dist-server/main.mjs",
    "build:server-image": "docker build -t machination-server:playtest .",
    "test:server-image": "node scripts/test-server-image.mjs"
  },
  "dependencies": {
    "@clerk/backend": "3.26.4",
    "@clerk/expo": "4.14.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.0",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-auth-session": "~55.0.19",
    "expo-clipboard": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-document-picker": "55.0.17",
    "expo-file-system": "55.0.26",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "55.0.25",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.0",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "esbuild": "0.28.2",
    "react-test-renderer": "19.2.0",
    "sharp": "0.35.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
