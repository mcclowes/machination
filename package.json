{
  "name": "machination",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/game/*.test.ts src/online/*.test.ts server/*.test.ts plugins/*.test.cjs",
    "build:web": "expo export --platform web",
    "server": "tsx server/main.ts",
    "build:android:playtest": "expo prebuild --platform android --no-install && cd android && ./gradlew :app:assembleRelease -PreactNativeArchitectures=arm64-v8a --console=plain --max-workers=2",
    "build:ios:simulator": "expo prebuild --platform ios --no-install && cd ios && pod install && cd .. && xcodebuild -workspace ios/Machination.xcworkspace -scheme Machination -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build/playtest CODE_SIGNING_ALLOWED=NO -jobs 2 -quiet build"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.0",
    "expo-crypto": "~55.0.19",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2",
    "tsx": "^4.21.0"
  }
}
