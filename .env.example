# Client: Machination Clerk app app_3LLM8dwZinMXaB6wYiCp8bJ4gFD.
# Linked development instance: ins_3LLM8hCmKUuaIwWTDdVu4VdM3m6.
# Use matching production-instance keys for release builds.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_ACCOUNT_URL=
EXPO_PUBLIC_GAME_SERVER=http://localhost:8787
# Existing EAS project UUID; native message notification opt-in is unavailable without it.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Server only. The issuer is the Clerk Frontend API HTTPS origin for that instance.
CLERK_ISSUER=
# Choose a secret key (fetches cached JWKS) or a PEM JWT public key (networkless verification).
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
MACHINATION_ORIGINS=http://localhost:8081,http://localhost:8082
# Use railway only when every access path is trusted Railway HTTP ingress.
MACHINATION_CLIENT_IP=direct
# Optional Postgres (Supabase) game storage; leave empty to use the JSON file. See docs/postgres.md.
DATABASE_URL=
# Verified TLS is the default. Use local only for disposable loopback databases.
MACHINATION_DATABASE_TLS=verify-full
# Optional provider root CA as PEM text, supplied as a server secret (not a file path).
MACHINATION_DATABASE_CA=
# Quarantine isolated damaged operations after preserving their source. Strict refuses startup.
MACHINATION_DATABASE_RECOVERY=quarantine

# Opt-in message delivery. Configure the EAS project's APNs/FCM credentials separately.
MACHINATION_PUSH_ENABLED=0
# Optional Expo enhanced push-security token; server only.
EXPO_ACCESS_TOKEN=

# Server-only balance overrides for new King's Pulse operations (JSON; time in hours).
# MACHINATION_PULSE_CONFIG={"chargeDuration":6,"activationResourceCost":100,"propagationSpeed":8}
