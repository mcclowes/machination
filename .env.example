# Client: shared Marginal Utility Clerk instance (use matching development keys locally).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_GAME_SERVER=http://localhost:8787

# Server only. The issuer is the Clerk Frontend API HTTPS origin for that instance.
